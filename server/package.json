{
  "name": "@shellink/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    "./runner": {
      "types": "./src/runner.ts",
      "default": "./dist/runner.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/e2e/extreme.test.ts --exclude test/e2e/abnormal.test.ts --exclude test/e2e/network-impairment.test.ts",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e --exclude test/e2e/extreme.test.ts --exclude test/e2e/abnormal.test.ts --exclude test/e2e/network-impairment.test.ts",
    "test:extreme": "vitest run test/e2e/extreme.test.ts",
    "test:abnormal": "vitest run test/e2e/abnormal.test.ts",
    "test:network": "vitest run test/e2e/network-impairment.test.ts",
    "test:coverage": "vitest run --coverage --exclude test/e2e/extreme.test.ts --exclude test/e2e/abnormal.test.ts --exclude test/e2e/network-impairment.test.ts",
    "test:coverage:full": "vitest run --coverage",
    "test:watch": "vitest",
    "test:docker:up": "docker compose -f test/docker/docker-compose.yml up -d --build --wait",
    "test:docker:down": "docker compose -f test/docker/docker-compose.yml down -v"
  },
  "dependencies": {
    "@shellink/protocol": "0.1.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.1.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}

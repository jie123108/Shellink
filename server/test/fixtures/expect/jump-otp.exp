#!/usr/bin/env expect
# Jump via bastion option 3 — stop at OTP for interactive input via Shellink session API
set timeout 60
set bastion_host [lindex $argv 0]
set bastion_port [lindex $argv 1]
if {$bastion_host == ""} { set bastion_host "127.0.0.1" }
if {$bastion_port == ""} { set bastion_port "2223" }

spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
  -p $bastion_port testuser@$bastion_host

expect {
  -re "(?i)password:" { send "testpass\r"; exp_continue }
  -re "Select option:" { send "3\r" }
  timeout { exit 1 }
}

expect {
  -re "OTP:" {}
  timeout { exit 1 }
}

# The Shellink session API supplies the OTP interactively. After it is
# accepted, the bastion execs ssh to the target, which prompts for a
# password again; auto-answer that on output (-o) while still passing
# through the OTP keystrokes typed via the session API.
interact -o -re "(?i)password:" { send "testpass\r" }
